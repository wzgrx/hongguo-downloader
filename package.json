{
  "name": "hongguo-downloader",
  "version": "1.0.0",
  "description": "红果短剧全集批量下载器（Windows 桌面版）",
  "main": "main.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "dev:react": "vite",
    "build:react": "vite build",
    "build": "npm run build:react && electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.hongguo.downloader",
    "productName": "红果短剧下载器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist-react/**/*",
      "src/native/**/*",
      "src/store.js"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build/ffmpeg",
        "to": "bin",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "红果短剧下载器",
      "artifactName": "红果短剧下载器-Setup-${version}.${ext}"
    }
  }
}
